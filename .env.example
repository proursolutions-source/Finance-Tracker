# MoneyFlow Cloud (Supabase) — required only for Subscription and Admin Portal
# features. Every other part of MoneyFlow works fully offline without these.
#
# Setup steps: see SETUP_SUPABASE.md
#
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). VITE_SUPABASE_ANON_KEY is the public "anon" key —
# safe to ship in client code because every table is protected by Row Level
# Security. Never put the "service_role" key here or anywhere in this app.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
