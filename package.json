{
    "name": "moneyflow",
    "version": "1.0.0",
    "description": "Privacy-first offline personal finance tracker with SQLite WASM + OPFS",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron electron/main.cjs",
        "electron:build": "vite build && electron-builder"
    },
    "main": "electron/main.cjs",
    "build": {
        "appId": "com.moneyflow.app",
        "productName": "MoneyFlow",
        "copyright": "MIT",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/**/*",
            "dist/**/*"
        ],
        "extraMetadata": {
            "main": "electron/main.cjs"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build-resources/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "public/icons/icon-512x512.png",
            "category": "Finance"
        }
    },
    "keywords": [
        "finance",
        "tracker",
        "offline",
        "pwa",
        "sqlite",
        "wasm",
        "opfs"
    ],
    "author": "MoneyFlow",
    "license": "MIT",
    "devDependencies": {
        "@capacitor/cli": "^8.5.2",
        "@types/node": "^20.11.5",
        "@types/qrcode": "^1.5.6",
        "autoprefixer": "^10.4.24",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.11"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/app": "^8.1.1",
        "@capacitor/browser": "^8.0.4",
        "@capacitor/core": "^8.5.2",
        "@supabase/supabase-js": "^2.116.0",
        "chart.js": "^4.4.1",
        "date-fns": "^3.3.1",
        "papaparse": "^5.4.1",
        "qrcode": "^1.5.4",
        "sql.js": "^1.10.3",
        "tesseract.js": "^7.0.0",
        "zod": "^3.22.4"
    }
}
